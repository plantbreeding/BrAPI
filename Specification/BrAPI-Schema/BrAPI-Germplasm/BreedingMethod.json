{
    "$defs": {
        "BreedingMethod": {
            "properties": {
                "abbreviation": {
                    "description": "A shortened version of the human readable name for a Breeding Method",
                    "type": [
                        "null",
                        "string"
                    ],
                    "examples": [
                        "GP"
                    ]
                },
                "breedingMethodDbId": {
                    "description": "the unique identifier for this breeding method",
                    "type": [
                        "string"
                    ],
                    "examples": [
                        "BM_123"
                    ]
                },
                "breedingMethodName": {
                    "description": "the human readable identifier for this breeding method",
                    "type": [
                        "null",
                        "string"
                    ],
                    "examples": [
                        "Generative Breeding"
                    ]
                },
                "description": {
                    "description": "human readable description of the breeding method",
                    "type": [
                        "null",
                        "string"
                    ],
                    "examples": [
                        "A description of the method"
                    ]
                },
                "type": {
                    "description": "The specific type of Breeding Method. Ex: 'Generative', 'Maintenance', or 'Derivative'.",
                    "type": [
                        "null",
                        "string"
                    ],
                    "examples": [
                        "Generative",
                        "Maintenance",
                        "Derivative"
                    ]
                },
                "germplasm": {
                    "title": "germplasm",
                    "description": "A collection of genetic material used in breeding programs.",
                    "referencedAttribute": "breedingMethod",
                    "relationshipType": "one-to-many",
                    "items": {
                        "$ref": "Germplasm.json#/$defs/Germplasm",
                        "description": "Germplasm"
                    },
                    "type": [
                        "null",
                        "array"
                    ],
                    "examples": []
                },
                "pedigreeNodes": {
                    "title": "pedigreeNodes",
                    "description": "A collection of nodes representing individuals within a breeding pedigree.",
                    "referencedAttribute": "breedingMethod",
                    "relationshipType": "one-to-many",
                    "items": {
                        "$ref": "PedigreeNode.json#/$defs/PedigreeNode",
                        "description": "PedigreeNode"
                    },
                    "type": [
                        "null",
                        "array"
                    ],
                    "examples": []
                }
            },
            "required": [
                "breedingMethodDbId"
            ],
            "title": "Breeding Method",
            "description": "The techniques and protocol used to produce a Cross or Germplasm",
            "type": "object",
            "brapi-metadata": {
                "primaryModel": true
            }
        }
    },
    "$id": "https://brapi.org/Specification/BrAPI-Schema/BrAPI-Germplasm/BreedingMethod.json",
    "$schema": "http://json-schema.org/draft/2020-12/schema"
